{
  "name": "HaggleTown",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "HaggleServer": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "HaggleClient": { "$path": "src/client" }
      }
    },
    "Workspace": {
      "$properties": { "StreamingEnabled": true },
      "Terrain": { "$properties": { "Decoration": true, "GrassLength": 0.25 } }
    },
    "ServerStorage": {
      "Assets": { "$path": "assets" }
    },
    "Lighting": {
      "$properties": { "Technology": "Future", "GlobalShadows": true, "ClockTime": 17.7, "Brightness": 2.4 }
    }
  }
}
