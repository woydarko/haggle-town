# Copy to .env. scripts/seed.sh fills the NEAR values from ~/.near-credentials. Never commit .env.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_RPC_FALLBACK_URL=https://rpc.testnet.near.org
CONTRACT_ID=haggletown.testnet
GAME_ACCOUNT_ID=game.haggletown.testnet
GAME_PRIVATE_KEY=
WOODCUTTER_PRIVATE_KEY=
FISHMONGER_PRIVATE_KEY=
SMITH_PRIVATE_KEY=
# Shared secret between the Roblox server and the backend (any long random string)
RBX_HMAC_SECRET=
# NEAR AI Cloud (OpenAI-compatible)
LLM_BASE_URL=https://cloud-api.near.ai/v1
LLM_MODEL=
LLM_API_KEY=
# off | record | on
REPLAY_MODE=off
DB_PATH=./data/haggle.sqlite
PORT=8080
DAY_LENGTH_MS=300000
